# Variablen fuer imagegen/docker-compose.yml.
# Kopieren nach ~/imagegen/imagegen.env und anpassen.

# Datenordner (Modelle, Ausgaben, Einstellungen) -- absoluter Pfad
IMAGEGEN_DATA=/srv/imagegen

# Host-User (id -u / id -g) und GPU-Gruppen (getent group video render)
PUID=1000
PGID=1000
VIDEO_GID=44
RENDER_GID=992

# Feste Version: Update = Wert aendern + "docker compose ... up -d --build"
COMFYUI_VERSION=v0.42.1

# Port (ohne Login -> nur im LAN freigeben)
COMFYUI_PORT=8188

# Web-App (Port 8190). Benutzer legt beim ersten Aufruf ein Einrichtungsassistent an
# (Admin), Daten in IMAGEGEN_DATA/webapp-data.
WEBAPP_PORT=8190
# Reverse-Proxys, deren X-Forwarded-For geglaubt wird (Default: private Netze + localhost).
# Fuer mehr Strenge nur die IP des eigenen Proxys eintragen, z.B. 10.0.0.2
#WEBAPP_TRUSTED_PROXIES=10.0.0.2

# "Ausformulieren" (Knopf am Prompt): Ollama-kompatibler Server, am besten der OllamaProxy.
# Leer = Knopf aus. Modell leer = Standardmodell des Servers.
#WEBAPP_LLM_URL=http://192.168.1.20:11435
#WEBAPP_LLM_MODEL=

# Modul fuer den OllamaProxy: Freigabe nach so vielen Minuten Leerlauf, optionaler Schluessel
#WEBAPP_IDLE_FREE_MINUTES=2
#WEBAPP_MODULE_TOKEN=
